#!/usr/bin/env python3
"""kk-emoji-list: writes ~/.cache/kajukatli/emoji.tsv (emoji, tab, its name) from python's own
unicode tables, so the app drawer's ":" search needs no download. ~1,400 lines, ~50 kb."""
import os
import unicodedata
from pathlib import Path

RANGES = [(0x1F300, 0x1F5FF), (0x1F600, 0x1F64F), (0x1F680, 0x1F6FF), (0x1F900, 0x1F9FF),
          (0x1FA70, 0x1FAFF), (0x2600, 0x26FF), (0x2700, 0x27BF), (0x1F1E6, 0x1F1FF)]
out = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "kajukatli" / "emoji.tsv"
out.parent.mkdir(parents=True, exist_ok=True)
lines = []
for a, b in RANGES:
    for cp in range(a, b + 1):
        ch = chr(cp)
        try:
            name = unicodedata.name(ch)
        except ValueError:
            continue
        if unicodedata.category(ch) != "So":
            continue
        lines.append(f"{ch}\t{name.lower()}")
tmp = out.with_suffix(".tmp")
tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
tmp.replace(out)
