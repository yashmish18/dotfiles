#!/bin/sh
# kk-shot region|window|screen [delay seconds] [--edit] [--output=NAME]
#   screen: the screen under the pointer, or --output=HDMI-A-1 for a particular one
# a screenshot → the clipboard and ~/Pictures/screenshots, with a notification:
#   open    the picture, in your image viewer
#   folder  the folder, with the file picked out (in the file manager)
#   edit    annotate it in satty
set -u
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
mode="${1:-region}"
delay=0
edit=0
want=""
for a in "$@"; do
    case "$a" in
        --edit) edit=1 ;;
        --output=*) want="${a#--output=}" ;;
        [0-9]|[0-9][0-9]) delay="$a" ;;
    esac
done
[ "$mode" = area ] && mode=region   # the old name

sound() {
    snd="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/kajukatli/sounds/$1.wav"
    if [ -f "$snd" ] && ! grep -q '"sounds": *false' "${XDG_CONFIG_HOME:-$HOME/.config}/kajukatli/settings.json" 2>/dev/null; then
        pw-play --volume 0.6 "$snd" >/dev/null 2>&1 &
    fi
}

case "$mode" in
    region)
        geom="$(slurp -d -b '#00000066' -c '#ffffffcc' -s '#00000000' -w 1)" || exit 0
        [ "$delay" -gt 0 ] && sleep "$delay"
        grim -g "$geom" "$file" ;;
    window)
        [ "$delay" -gt 0 ] && sleep "$delay"
        geom="$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')"
        grim -g "$geom" "$file" ;;
    screen)
        [ "$delay" -gt 0 ] && sleep "$delay"
        # the screen the pointer is on (with extended screens that's the one you mean; the
        # focused one can still be the other screen), the focused one if that can't be told
        out="$(jq -rn --argjson m "$(hyprctl monitors -j)" --argjson c "$(hyprctl cursorpos -j 2>/dev/null || echo null)" '
            if $c == null then empty else
              [$m[] | select(($c.x >= .x) and ($c.x < .x + (.width / .scale)) and ($c.y >= .y) and ($c.y < .y + (.height / .scale)))][0].name // empty end' 2>/dev/null)"
        [ -n "$out" ] || out="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')"
        [ -n "$want" ] && out="$want"
        grim -o "$out" "$file" ;;
    *) echo "usage: kk-shot region|window|screen [delay] [--edit]" >&2; exit 2 ;;
esac

[ -s "$file" ] || exit 1
wl-copy --type image/png < "$file"
sound shutter

if [ "$edit" = 1 ] && command -v satty >/dev/null; then
    exec satty --filename "$file" --output-filename "$file" --copy-command wl-copy
fi

action="$(notify-send -a Screenshot -i "$file" --action=open=Open --action=folder=Folder --action=edit=Edit \
    "Screenshot" "$(basename "$file") · copied")"
case "$action" in
    open) xdg-open "$file" ;;
    folder)
        # ask the file manager to show the file itself; fall back to opening the folder in one
        uri="file://$file"
        gdbus call --session --dest org.freedesktop.FileManager1 --object-path /org/freedesktop/FileManager1 \
            --method org.freedesktop.FileManager1.ShowItems "['$uri']" "" >/dev/null 2>&1 \
        || { command -v thunar >/dev/null && thunar "$dir"; } ;;
    edit) satty --filename "$file" --output-filename "$file" --copy-command wl-copy ;;
esac
