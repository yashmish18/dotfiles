#!/bin/sh
# kk-sys — prints one line of json with system counters every N seconds (default 2).
# the shell turns the raw counters into rates. it never wakes a sleeping nvidia card:
# gpu numbers only come from drivers that expose them in sysfs (amdgpu, some intel).
iv="${1:-2}"

cpu_hw=""; gpu_hw=""; fan_f=""
for h in /sys/class/hwmon/hwmon*; do
    [ -d "$h" ] || continue
    case "$(cat "$h/name" 2>/dev/null)" in
        coretemp|k10temp|zenpower|cpu_thermal|thinkpad) [ -z "$cpu_hw" ] && cpu_hw="$h" ;;
        amdgpu|radeon|nouveau|i915|xe) [ -z "$gpu_hw" ] && gpu_hw="$h" ;;
    esac
    [ -z "$fan_f" ] && [ -r "$h/fan1_input" ] && fan_f="$h/fan1_input"
done
cpu_t=""
[ -n "$cpu_hw" ] && [ -r "$cpu_hw/temp1_input" ] && cpu_t="$cpu_hw/temp1_input"
if [ -z "$cpu_t" ]; then
    for z in /sys/class/thermal/thermal_zone*; do
        case "$(cat "$z/type" 2>/dev/null)" in x86_pkg_temp|cpu*|acpitz) cpu_t="$z/temp"; break ;; esac
    done
fi
gpu_t=""; [ -n "$gpu_hw" ] && [ -r "$gpu_hw/temp1_input" ] && gpu_t="$gpu_hw/temp1_input"
gpu_busy_f="$(ls /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -n1)"
bat="$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n1)"

num() { v="$(cat "$1" 2>/dev/null)"; [ -n "$v" ] && echo "$v" || echo "$2"; }

i=0; disk="0 1"
while :; do
    t="$(date +%s%3N)"
    cpu="$(awk '/^cpu /{t=0; for(i=2;i<=9;i++) t+=$i; print t-$5-$6, t; exit}' /proc/stat)"
    mem="$(awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{printf "%d %d", t*1024, a*1024}' /proc/meminfo)"
    net="$(awk 'NR>2 {sub(/^ +/, ""); n=split($0, a, /[: ]+/); if (a[1] != "lo" && a[1] !~ /^(veth|docker|br-|virbr)/) {rx+=a[2]; tx+=a[10]}} END{printf "%.0f %.0f", rx, tx}' /proc/net/dev 2>/dev/null)"
    # a missing source must never shift the fields below
    [ -n "$cpu" ] || cpu="0 1"
    [ -n "$mem" ] || mem="0 0"
    [ -n "$net" ] || net="0 0"
    if [ $((i % 15)) -eq 0 ]; then
        disk="$(df -B1 --output=used,size / 2>/dev/null | awk 'NR==2{print $1, $2}')"
        [ -n "$disk" ] || disk="0 1"
    fi
    ct=-1; [ -n "$cpu_t" ] && ct="$(awk '{printf "%.1f", $1/1000}' "$cpu_t" 2>/dev/null || echo -1)"
    gt=-1; [ -n "$gpu_t" ] && gt="$(awk '{printf "%.1f", $1/1000}' "$gpu_t" 2>/dev/null || echo -1)"
    gb=-1; [ -n "$gpu_busy_f" ] && gb="$(num "$gpu_busy_f" -1)"
    fan=-1; [ -n "$fan_f" ] && fan="$(num "$fan_f" -1)"
    pw=-1
    if [ -n "$bat" ]; then
        if [ -r "$bat/power_now" ]; then pw="$(awk '{printf "%.2f", $1/1000000}' "$bat/power_now" 2>/dev/null || echo -1)"
        elif [ -r "$bat/current_now" ] && [ -r "$bat/voltage_now" ]; then
            pw="$(awk -v c="$(cat "$bat/current_now")" -v v="$(cat "$bat/voltage_now")" 'BEGIN{printf "%.2f", c*v/1e12}')"
        fi
    fi
    set -- $cpu $mem $net $disk
    printf '{"t":%s,"cpu_busy":%s,"cpu_total":%s,"mem_total":%s,"mem_avail":%s,"rx":%s,"tx":%s,"disk_used":%s,"disk_total":%s,"cpu_temp":%s,"gpu_temp":%s,"gpu_busy":%s,"fan":%s,"power":%s}\n' \
        "$t" "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$ct" "$gt" "$gb" "$fan" "$pw"
    i=$((i + 1))
    sleep "$iv"
done
