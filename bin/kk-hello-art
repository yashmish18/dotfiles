#!/usr/bin/env python3
"""kk-hello-art [--preview FILE.png]
draw the smoking kitty for the terminal greeting: pixel art, two pixels per character cell
(half blocks), in 24-bit colour taken from the desktop theme. writes
~/.cache/kajukatli/hello-logo.txt, which fastfetch prints as its logo. kk-theme runs this
after every wallpaper change; kk-hello runs it if the file is missing. pure python, ~20 ms."""
import json
import os
import sys
from pathlib import Path

CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "kajukatli"

# the sprite. one character per pixel:
#   .  nothing          K  outline           F  fur              S  fur in shade
#   P  inside the ears, the nose             W  muzzle, cigarette paper
#   G  sunglasses       H  glint on the glass                   A  ash
#   E  ember            e  ember's glow      M  smoke            m  thin smoke
SPRITE = """
..............................mm..
.............................m..m.
.............................m....
..............................mm..
................................m.
................................M.
..K...............K............MM.
.KFK.............KFK..........MM..
.KPFK...........KFPK.........MM...
.KPPFKKKKKKKKKKKFPPK.........M....
KFPFFFFFFFFFFFFFFFPFK........MM...
KFFFFFFFFFFFFFFFFFFFK.........MM..
KFGGGGGGFFFFFGGGGGGFK..........M..
KGGHHGGGGGGGGGHHGGGGK.........MM..
KGGHGGGGGFFFGGHGGGGGK........MM...
KFGGGGGGFSSSFGGGGGGFK........M....
KFFGGGGFFSPSFFGGGGFFK.......MM....
KSFFFFFFWWPWWFFFFFFSK.......M.....
.KSFFFFWWWWWWWFFFFSK........e.....
.KSSFFFWWWKWWWWWWWWWWWWWWAAAEe....
..KSSFFFWWWWWFFFFSSK..........e...
...KKSSSFFFFFFSSSKK...............
.....KKKKKKKKKKKK.................
"""


def hexrgb(h: str) -> tuple:
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def mix(a: tuple, b: tuple, t: float) -> tuple:
    return tuple(round(x * (1 - t) + y * t) for x, y in zip(a, b))


def palette() -> dict:
    try:
        t = json.loads((CACHE / "theme.json").read_text())
    except (OSError, ValueError):
        t = {}
    acc = hexrgb(t.get("primary", "#e9a86b"))
    dark = bool(t.get("dark", True))
    fur = mix(acc, (255, 255, 255), 0.25) if dark else mix(acc, (0, 0, 0), 0.1)
    return {
        "K": (18, 16, 20),
        "F": fur,
        "S": mix(fur, (0, 0, 0), 0.3),
        "P": (238, 140, 160),
        "W": (244, 240, 232),
        "G": (14, 13, 18),
        "H": (120, 190, 255),
        "A": (130, 126, 122),
        "E": (255, 92, 40),
        "e": (255, 170, 60),
        "M": (178, 174, 182),
        "m": (120, 116, 126),
    }


def grid() -> list:
    rows = [r for r in SPRITE.strip("\n").split("\n")]
    w = max(len(r) for r in rows)
    rows = [r.ljust(w, ".") for r in rows]
    if len(rows) % 2:
        rows.append("." * w)
    return rows


def render(pal: dict) -> str:
    rows = grid()
    out = []
    fg = lambda c: f"\x1b[38;2;{c[0]};{c[1]};{c[2]}m"
    bg = lambda c: f"\x1b[48;2;{c[0]};{c[1]};{c[2]}m"
    for y in range(0, len(rows), 2):
        line = []
        for x in range(len(rows[y])):
            top, bot = rows[y][x], rows[y + 1][x]
            if top == "." and bot == ".":
                line.append("\x1b[0m ")
            elif bot == ".":
                line.append("\x1b[0m" + fg(pal[top]) + "▀")
            elif top == ".":
                line.append("\x1b[0m" + fg(pal[bot]) + "▄")
            else:
                line.append(fg(pal[top]) + bg(pal[bot]) + "▀")
        out.append("".join(line).rstrip() + "\x1b[0m")
    return "\n".join(out) + "\n"


def preview(pal: dict, path: str) -> None:
    from PIL import Image
    rows = grid()
    im = Image.new("RGB", (len(rows[0]), len(rows)), (24, 22, 28))
    for y, r in enumerate(rows):
        for x, ch in enumerate(r):
            if ch != ".":
                im.putpixel((x, y), pal[ch])
    im.resize((im.width * 14, im.height * 14), Image.NEAREST).save(path)


def main() -> int:
    pal = palette()
    if len(sys.argv) == 3 and sys.argv[1] == "--preview":
        preview(pal, sys.argv[2])
        return 0
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = CACHE / ".hello-logo.txt"
    tmp.write_text(render(pal), encoding="utf-8")
    tmp.replace(CACHE / "hello-logo.txt")
    return 0


if __name__ == "__main__":
    sys.exit(main())
