#!/bin/sh
# kk-files [path]   a new Nautilus window (super + e). not installed? it offers to install it.
set -u
if command -v nautilus >/dev/null 2>&1; then
    exec nautilus --new-window "$@"
fi
notify-send -a Files "Nautilus isn't installed" "Opening a terminal to install it." 2>/dev/null
exec kitty -e sh -c 'echo "installing nautilus (files, drives, phones, archives, thumbnails):"; sudo pacman -S --needed nautilus gvfs gvfs-mtp file-roller sushi; echo; echo "done. press super + e again."; read -r _'
