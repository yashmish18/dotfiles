#!/bin/sh
# kk-files [path]   a new file manager window (super + e). uses the first one installed: nautilus,
#                   then thunar, nemo, pcmanfm, dolphin. none? it offers to install nautilus.
set -u
for fm in nautilus thunar nemo pcmanfm dolphin; do
    if command -v "$fm" >/dev/null 2>&1; then
        case "$fm" in
            nautilus) exec nautilus --new-window "$@" ;;
            *) exec "$fm" "$@" ;;
        esac
    fi
done
notify-send -a Files "No file manager installed" "Opening a terminal to install Nautilus." 2>/dev/null
exec kitty -e sh -c 'echo "no file manager found. installing nautilus:"; sudo pacman -S --needed nautilus gvfs gvfs-mtp; echo; echo "done. press super + e again."; read -r _'
