#!/usr/bin/env bash
# kk-storage report            one line of json: every disk, what fills your home, what can go
# kk-storage drives            the drives (lsblk json): internal, usb sticks, sd cards
# kk-storage clean <what>      trash | thumbnails | cache | walls | pacman | journal | orphans | aur | all-safe
# kk-storage trash list        what's in the recycle bin (json lines)
# kk-storage trash restore|delete <trash uri>      kk-storage trash empty
# kk-storage mount|unmount|eject <device>
# kk-storage format <device> <exfat|fat32|ext4|ntfs|btrfs> [label]   (never the system disk)
# kk-storage why               where the space went: the biggest things on the system, largest first
# kk-storage tidy              the safe clean-ups at once, and caps on what grows (install.sh and
#                              --update run it): clipboard images, crash dumps, caches, old packages
# the shell's task manager (ctrl + shift + esc) → storage uses all of this.
set -uo pipefail
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/kajukatli"

# don't append a fallback 0: with pipefail, du exiting non-zero on an unreadable
# subdir (e.g. pacman's download-* dirs) would emit a second line and break the JSON.
size() { local s; s="$(du -sb "$1" 2>/dev/null | head -n1 | cut -f1)"; echo "${s:-0}"; }
sizeq() { local s; s="$(size "$1")"; echo "${s:-0}"; }
jstr() { printf '%s' "$1" | jq -Rs .; }

# the wallpaper bundles the current wallpaper uses: never cleaned
current_wall_dir() {
    local cur
    cur="$(jq -r '.wallMeta.dir // empty' "$STATE/state.json" 2>/dev/null)"
    printf '%s' "$cur"
}

# bytes a clean-up target holds right now (so a clean-up can say what it freed)
clean_size() {
    case "$1" in
        trash) sizeq "$DATA/Trash" ;;
        thumbnails) sizeq "$CACHE/thumbnails" ;;
        cache) sizeq "$CACHE" ;;
        walls) sizeq "$CACHE/kajukatli/walls" ;;
        pacman) sizeq /var/cache/pacman/pkg ;;
        aur) echo $(( $(sizeq "$CACHE/paru") + $(sizeq "$CACHE/yay") )) ;;
        journal) numfmt --from=iec "$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]?' | head -n1)" 2>/dev/null || echo 0 ;;
        all-safe) sizeq "$CACHE" ;;
        *) echo 0 ;;
    esac
}
human() { numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0} B"; }

case "${1:-report}" in
    report)
        disks="$(df -B1 -x tmpfs -x devtmpfs -x efivarfs -x squashfs -x overlay --output=source,fstype,size,used,avail,target 2>/dev/null | tail -n +2 |
            awk '!seen[$1]++ {printf "{\"dev\":\"%s\",\"fs\":\"%s\",\"size\":%s,\"used\":%s,\"free\":%s,\"mount\":\"%s\"}\n",$1,$2,$3,$4,$5,$6}' | jq -sc .)"
        homes="["
        first=1
        for d in Downloads Documents Pictures Videos Music Desktop Projects; do
            p="$HOME/$d"; [ -d "$p" ] || continue
            [ $first = 1 ] || homes="$homes,"; first=0
            homes="$homes{\"name\":\"$d\",\"path\":$(jstr "$p"),\"size\":$(sizeq "$p")}"
        done
        homes="$homes]"
        pac=$(sizeq /var/cache/pacman/pkg)
        journal=$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]?B?' | head -n1)
        jbytes=$(numfmt --from=iec "${journal%B}" 2>/dev/null || echo 0)
        trash=$(sizeq "$DATA/Trash")
        thumbs=$(sizeq "$CACHE/thumbnails")
        walls=$(sizeq "$CACHE/kajukatli/walls")
        usercache=$(sizeq "$CACHE")
        aur=$(( $(sizeq "$CACHE/paru") + $(sizeq "$CACHE/yay") ))
        orphans=$(pacman -Qdtq 2>/dev/null | wc -l)
        printf '{"disks":%s,"home":%s,"clean":{"trash":%s,"thumbnails":%s,"walls":%s,"cache":%s,"pacman":%s,"journal":%s,"aur":%s,"orphans":%s}}\n' \
            "${disks:-[]}" "$homes" "$trash" "$thumbs" "$walls" "$usercache" "$pac" "${jbytes:-0}" "$aur" "$orphans"
        ;;
    drives)
        lsblk -J -b -o NAME,PATH,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINT,RM,HOTPLUG,MODEL,TRAN 2>/dev/null
        ;;
    clean)
        what="${2:-}"
        before="$(clean_size "$what")"
        case "$what" in
            # gio can't empty the bin on some setups; take the files out by hand either way
            trash) gio trash --empty >/dev/null 2>&1; rm -rf "$DATA/Trash/files/"* "$DATA/Trash/info/"* "$DATA/Trash/directorysizes" 2>/dev/null; true ;;
            thumbnails) rm -rf "$CACHE/thumbnails/"* 2>/dev/null; true ;;
            # the parts of ~/.cache every app rebuilds by itself
            # only what apps rebuild by themselves AND nothing the running session has open: the
            # gpu shader caches (mesa, nvidia, qt), the font cache and the qml cache are memory-mapped
            # by the shell and every app, and deleting them underneath makes them crash
            cache) rm -rf "$CACHE/thumbnails/"* "$CACHE/pip" "$CACHE/go-build" "$CACHE/yarn" "$CACHE/npm" "$CACHE/pnpm" "$CACHE/electron" 2>/dev/null; true ;;
            # wallpaper bundles (they come back when that wallpaper is picked again), never the one
            # on screen now. `walls old` (the automatic tidy) leaves anything used in the last 30 days
            walls)
                keep="$(current_wall_dir)"
                age=(); [ "${3:-}" = old ] && age=(-mtime +30)
                find "$CACHE/kajukatli/walls" -mindepth 1 -maxdepth 1 -type d "${age[@]}" 2>/dev/null | while IFS= read -r d; do
                    [ "$d" = "$keep" ] || rm -rf "$d"
                done
                rm -f "$CACHE/kajukatli/index.json" ;;
            pacman)
                if command -v paccache >/dev/null; then pkexec sh -c 'paccache -rk1; paccache -ruk0; true'
                else pkexec sh -c 'yes | pacman -Sc --noconfirm'; fi ;;
            journal) pkexec journalctl --vacuum-size=100M ;;
            orphans)
                o="$(pacman -Qdtq 2>/dev/null)"
                [ -n "$o" ] || exit 0
                # shellcheck disable=SC2086
                pkexec pacman -Rns --noconfirm $o ;;
            aur) rm -rf "$CACHE/paru/clone" "$CACHE/yay" 2>/dev/null; true ;;
            all-safe) "$0" clean thumbnails >/dev/null; "$0" clean cache >/dev/null; "$0" clean aur >/dev/null; "$0" clean walls old >/dev/null ;;
            *) echo "clean what? trash thumbnails cache walls pacman journal orphans aur all-safe" >&2; exit 2 ;;
        esac
        rc=$?
        # say what happened, so a clean-up that had nothing to do doesn't look like one that failed
        if [ "$rc" -ne 0 ]; then exit "$rc"
        elif [ "$what" != orphans ]; then
            freed=$(( ${before:-0} - $(clean_size "$what") ))
            if [ "$freed" -gt 0 ]; then echo "freed $(human "$freed")"; else echo "nothing to clean"; fi
        fi
        ;;
    trash)
        case "${2:-list}" in
            list)
                # one json object per item: its trash uri, where it came from, when, how big
                for info in "$DATA"/Trash/info/*.trashinfo; do
                    [ -f "$info" ] || continue
                    name="$(basename "$info" .trashinfo)"
                    orig="$(sed -n 's/^Path=//p' "$info" | head -n1)"
                    orig="$(printf '%b' "${orig//%/\\x}")"
                    when="$(sed -n 's/^DeletionDate=//p' "$info" | head -n1)"
                    f="$DATA/Trash/files/$name"
                    printf '{"uri":%s,"name":%s,"orig":%s,"when":%s,"size":%s,"dir":%s}\n' \
                        "$(jstr "trash:///$name")" "$(jstr "$name")" "$(jstr "$orig")" "$(jstr "$when")" "$(sizeq "$f")" "$([ -d "$f" ] && echo true || echo false)"
                done ;;
            restore)
                uri="${3:-}"; name="${uri#trash:///}"
                gio trash --restore "$uri" 2>/dev/null && exit 0
                # older glib: by hand
                orig="$(sed -n 's/^Path=//p' "$DATA/Trash/info/$name.trashinfo" | head -n1)"
                orig="$(printf '%b' "${orig//%/\\x}")"
                [ -n "$orig" ] && [ ! -e "$orig" ] || { echo "something is already at $orig" >&2; exit 1; }
                mkdir -p "$(dirname "$orig")" && mv "$DATA/Trash/files/$name" "$orig" && rm -f "$DATA/Trash/info/$name.trashinfo" ;;
            delete)
                name="${3#trash:///}"
                [ -n "$name" ] && [ "$name" != "." ] && [ "$name" != ".." ] || exit 2
                rm -rf "$DATA/Trash/files/$name" "$DATA/Trash/info/$name.trashinfo" ;;
            empty) "$0" clean trash ;;
        esac
        ;;
    mount)   udisksctl mount -b "${2:?device}" ;;
    unmount) udisksctl unmount -b "${2:?device}" ;;
    eject)   udisksctl unmount -b "${2:?device}" 2>/dev/null; udisksctl power-off -b "${2:?device}" ;;
    format)
        dev="${2:?device}"; fs="${3:-exfat}"; label="${4:-}"
        # never anything on the disk the system runs from
        disk="/dev/$(lsblk -no PKNAME "$dev" 2>/dev/null | head -n1)"
        [ "$disk" = "/dev/" ] && disk="$dev"
        if lsblk -nro MOUNTPOINT "$disk" 2>/dev/null | grep -qxE '/|/boot|/boot/efi|/efi|/home|\[SWAP\]'; then
            echo "that's the disk the system runs from: not formatting it" >&2; exit 1
        fi
        case "$fs" in
            exfat) cmd="mkfs.exfat ${label:+-L \"$label\"} \"$dev\"" ;;
            fat32) cmd="mkfs.fat -F 32 ${label:+-n \"${label:0:11}\"} \"$dev\"" ;;
            ext4)  cmd="mkfs.ext4 -F ${label:+-L \"$label\"} \"$dev\"" ;;
            ntfs)  cmd="mkfs.ntfs -f ${label:+-L \"$label\"} \"$dev\"" ;;
            btrfs) cmd="mkfs.btrfs -f ${label:+-L \"$label\"} \"$dev\"" ;;
            *) echo "format as exfat, fat32, ext4, ntfs or btrfs" >&2; exit 2 ;;
        esac
        # unmount everything on it, clear the old signatures, then the new filesystem
        for p in $(lsblk -nro PATH "$dev"); do udisksctl unmount -b "$p" >/dev/null 2>&1 || true; done
        pkexec sh -c "wipefs -a \"$dev\" >/dev/null && $cmd" || exit 1
        # ext4/btrfs: make it yours, not root's
        case "$fs" in ext4|btrfs)
            m="$(udisksctl mount -b "$dev" 2>/dev/null | sed -n 's/.* at \(.*\)$/\1/p')"
            [ -n "$m" ] && pkexec chown "$USER:" "$m" ;;
        esac
        echo "formatted $dev as $fs"
        ;;
    why)
        # the biggest things, wherever they are (only what you're allowed to read; the system
        # folders that usually grow are measured with sudo when it doesn't need a password)
        s() { du -sxb "$1" 2>/dev/null | cut -f1; }
        S() { sudo -n du -sxb "$1" 2>/dev/null | cut -f1 || du -sxb "$1" 2>/dev/null | cut -f1; }
        {
            for p in "$HOME"/.cache/* "$HOME"/.local/share/* "$HOME"/.local/state/* "$HOME"/.config/* \
                     "$HOME"/Pictures/* "$HOME"/Videos/* "$HOME"/Downloads "$HOME"/Documents "$HOME"/Music \
                     "$HOME"/.var "$HOME"/.cargo "$HOME"/.rustup "$HOME"/.npm "$HOME"/.m2 "$HOME"/.gradle \
                     "$HOME"/go "$HOME"/.local/share/containers "$HOME"/.mozilla "$HOME"/.steam; do
                [ -e "$p" ] && printf '%s\t%s\n' "$(s "$p")" "${p/#$HOME/\~}"
            done
            for p in /var/cache/pacman/pkg /var/lib/systemd/coredump /var/log/journal /var/lib/docker \
                     /var/lib/flatpak /var/lib/containers /usr/lib/modules /opt /var/tmp /tmp /swapfile; do
                [ -e "$p" ] && printf '%s\t%s\n' "$(S "$p")" "$p"
            done
            db="$CACHE/cliphist/db"; [ -f "$db" ] && printf '%s\t%s\n' "$(s "$db")" "~/.cache/cliphist (clipboard history)"
        } | awk -F'\t' '$1 > 50*1024*1024' | sort -rn | head -n 25 |
            while IFS=$'\t' read -r b p; do printf '%10s  %s\n' "$(numfmt --to=iec "$b")" "$p"; done
        echo
        echo "packages: $(pacman -Qq | wc -l) installed, $(numfmt --to=iec "$(LC_ALL=C pacman -Qi 2>/dev/null | awk -F': ' '/^Installed Size/ {
            split($2, a, " "); m = (a[2] == "GiB") ? 1073741824 : (a[2] == "MiB") ? 1048576 : (a[2] == "KiB") ? 1024 : 1; t += a[1] * m } END {printf "%d", t}')") on disk"
        echo "biggest packages:"
        LC_ALL=C pacman -Qi 2>/dev/null | awk -F': ' '/^Name/ {n=$2} /^Installed Size/ {
            split($2, a, " "); m = (a[2] == "GiB") ? 1024 : (a[2] == "MiB") ? 1 : 0; if (m) printf "%8.0f MiB  %s\n", a[1] * m, n }' | sort -rn | head -n 10
        ;;
    tidy)
        # safe, automatic, and quiet: nothing you made, nothing you'd miss
        rm -rf "$CACHE/pip" "$CACHE/paru/clone" "$CACHE/yay" "$CACHE/go-build" 2>/dev/null
        find "$CACHE/thumbnails" -type f -atime +30 -delete 2>/dev/null
        # what you chose to keep (settings → storage), read from settings.json
        set_="${XDG_CONFIG_HOME:-$HOME/.config}/kajukatli/settings.json"
        pref() { jq -r --arg k "$1" --arg d "$2" '.[$k] // $d' "$set_" 2>/dev/null || echo "$2"; }
        keep_clip="$(pref clipboardKeep 30)"
        # clipboard history: wiped at login (unless you said not to), never more than your limit
        if command -v cliphist >/dev/null; then
            if [ "${2:-}" = --login ] && [ "$(pref clipboardClearAtLogin true)" = true ]; then
                cliphist wipe 2>/dev/null
            else
                cliphist list 2>/dev/null | tail -n +"$((keep_clip + 1))" | cliphist delete 2>/dev/null
            fi
        fi
        # your screenshots / recordings: only if you set an age (they're yours: kept by default)
        d="$(pref screenshotsDays 0)"; [ "$d" -gt 0 ] 2>/dev/null && find "${XDG_PICTURES_DIR:-$HOME/Pictures}/screenshots" -type f -mtime +"$d" -delete 2>/dev/null
        d="$(pref recordingsDays 0)"; [ "$d" -gt 0 ] 2>/dev/null && find "${XDG_VIDEOS_DIR:-$HOME/Videos}/recordings" -type f -mtime +"$d" -delete 2>/dev/null
        # the recycle bin: what's been there longer than your limit
        d="$(pref trashDays 30)"
        if [ "$d" -gt 0 ] 2>/dev/null; then
            for info in "$DATA"/Trash/info/*.trashinfo; do
                [ -f "$info" ] && [ -n "$(find "$info" -mtime +"$d" 2>/dev/null)" ] || continue
                n="$(basename "$info" .trashinfo)"
                rm -rf "$DATA/Trash/files/$n" "$info"
            done
        fi
        # wallpaper workspace: unused for 30 days, and never more than 768 mb in all
        "$0" clean walls old >/dev/null
        keep="$(current_wall_dir)"
        total=$(sizeq "$CACHE/kajukatli/walls")
        if [ "$total" -gt $((768 * 1024 * 1024)) ]; then
            find "$CACHE/kajukatli/walls" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -n | while read -r _ d; do
                [ "$(sizeq "$CACHE/kajukatli/walls")" -gt $((512 * 1024 * 1024)) ] || break
                [ "$d" = "$keep" ] || rm -rf "$d"
            done
        fi
        # the system part only when sudo is already unlocked (the installer) — never a prompt here
        if sudo -n true 2>/dev/null; then
            command -v paccache >/dev/null && { sudo -n paccache -rk1 -q; sudo -n paccache -ruk0 -q; } 2>/dev/null
            sudo -n journalctl --vacuum-size=200M -q 2>/dev/null
            sudo -n find /var/lib/systemd/coredump -type f -mtime +3 -delete 2>/dev/null
        fi
        true
        ;;
    *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
