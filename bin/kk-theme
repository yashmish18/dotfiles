#!/usr/bin/env python3
"""
kk-theme — colour the whole desktop from a wallpaper.

    kk-theme <bundle dir | meta.json | #hex>
    kk-theme --reapply            (the current wallpaper, e.g. after changing the scheme)

builds a tonal scheme (material-you style roles, computed in oklch) from the
wallpaper's seed colour and writes it to the shell, kitty, hyprland, gtk, qt and
kde apps. the flavour comes from ~/.config/kajukatli/settings.json:

    themeScheme   vibrant | tonal | mono      (mono = the old black & white print look)
    themeMode     dark | light | auto         (auto follows the wallpaper's brightness)

files it writes carry a marker line; a file without the marker is yours and is
left alone. no dependencies beyond python itself.
"""
from __future__ import annotations

import json
import math
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "kajukatli"
SETTINGS = CONFIG / "kajukatli" / "settings.json"
MARK = "generated by kk-theme"
DEFAULT_SEED = "#c9b79c"


# ------------------------------------------------------------------ colour maths (oklab / oklch)

def hex_rgb(h: str) -> tuple[float, float, float]:
    h = h.lstrip("#")
    return int(h[0:2], 16) / 255, int(h[2:4], 16) / 255, int(h[4:6], 16) / 255


def rgb_hex(r: float, g: float, b: float) -> str:
    c = lambda v: max(0, min(255, round(v * 255)))
    return f"#{c(r):02x}{c(g):02x}{c(b):02x}"


def _lin(c: float) -> float:
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _gam(c: float) -> float:
    return 12.92 * c if c <= 0.0031308 else 1.055 * (max(c, 0.0) ** (1 / 2.4)) - 0.055


def hex_oklch(h: str) -> tuple[float, float, float]:
    r, g, b = (_lin(v) for v in hex_rgb(h))
    l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
    m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
    s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
    l, m, s = (math.copysign(abs(v) ** (1 / 3), v) for v in (l, m, s))
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L, math.hypot(A, B), math.degrees(math.atan2(B, A)) % 360


def _oklch_lin(L: float, C: float, H: float) -> tuple[float, float, float]:
    a, b = C * math.cos(math.radians(H)), C * math.sin(math.radians(H))
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)


def oklch_hex(L: float, C: float, H: float) -> str:
    """oklch → srgb hex, pulling chroma in until the colour fits the srgb gamut."""
    L = max(0.0, min(1.0, L))
    lo, hi = 0.0, C
    rgb = _oklch_lin(L, C, H)
    if any(v < -1e-4 or v > 1 + 1e-4 for v in rgb):
        for _ in range(22):
            mid = (lo + hi) / 2
            rgb = _oklch_lin(L, mid, H)
            if any(v < -1e-4 or v > 1 + 1e-4 for v in rgb):
                hi = mid
            else:
                lo = mid
        rgb = _oklch_lin(L, lo, H)
    return rgb_hex(*(_gam(min(1.0, max(0.0, v))) for v in rgb))


def tone_L(t: float) -> float:
    """material 'tone' (cie L*, 0..100) → oklab L, so tones read like m3's."""
    if t <= 0:
        return 0.0
    fy = (t + 16) / 116
    y = fy ** 3 if fy ** 3 > 0.008856 else (t / 903.3)
    return y ** (1 / 3)


class Palette:
    def __init__(self, hue: float, chroma: float):
        self.h, self.c = hue, chroma

    def __call__(self, t: float) -> str:
        return oklch_hex(tone_L(t), self.c, self.h)


def mix(a: str, b: str, t: float) -> str:
    ra, ga, ba = hex_rgb(a)
    rb, gb, bb = hex_rgb(b)
    return rgb_hex(ra + (rb - ra) * t, ga + (gb - ga) * t, ba + (bb - ba) * t)


def hue_toward(h: float, target: float, k: float) -> float:
    d = ((target - h + 180) % 360) - 180
    return (h + d * k) % 360


# ------------------------------------------------------------------ the scheme

def settings() -> dict:
    try:
        return json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        return {}


def build_scheme(seed: str, accent: str, luma: float, flavour: str, mode: str, luma_top: float | None = None) -> dict:
    sL, sC, sH = hex_oklch(seed or DEFAULT_SEED)
    grey = not seed or sC < 0.02
    if grey:                           # a grey wallpaper: warm paper-white neutrals
        sH, sC = 70.0, 0.02
        if flavour == "vibrant":
            flavour = "tonal"

    if flavour == "mono":
        aL, aC, aH = hex_oklch(accent or DEFAULT_SEED)
        P = Palette(aH, min(aC, 0.06))
        S = Palette(aH, 0.02)
        T = Palette(aH + 40, 0.04)
        N = Palette(70, 0.004)
        NV = Palette(70, 0.008)
    elif flavour == "tonal":
        c = min(max(sC, 0.06), 0.11)
        P = Palette(sH, c)
        S = Palette(sH, c * 0.4)
        T = Palette(sH + 60, c * 0.7)
        N = Palette(sH, 0.008)
        NV = Palette(sH, 0.02)
    else:  # vibrant
        c = min(max(sC * 1.15, 0.11), 0.19)
        P = Palette(sH, c)
        S = Palette(sH + 15, c * 0.45)
        T = Palette(sH + 50, c * 0.8)
        N = Palette(sH, 0.014)
        NV = Palette(sH, 0.032)
    E = Palette(25, 0.17)
    G = Palette(145, 0.11)

    dark = mode != "light" and not (mode == "auto" and luma > 0.6)
    if dark:
        r = {
            "primary": P(80), "onPrimary": P(20), "primaryContainer": P(30), "onPrimaryContainer": P(90),
            "secondary": S(80), "onSecondary": S(20), "secondaryContainer": S(30), "onSecondaryContainer": S(90),
            "tertiary": T(80), "onTertiary": T(20), "tertiaryContainer": T(30), "onTertiaryContainer": T(90),
            "error": E(80), "onError": E(20), "success": G(80),
            "background": N(6), "surface": N(6), "surfaceDim": N(6), "surfaceBright": N(24),
            "surfaceContainerLowest": N(4), "surfaceContainerLow": N(10), "surfaceContainer": N(12),
            "surfaceContainerHigh": N(17), "surfaceContainerHighest": N(22),
            "onSurface": N(90), "onSurfaceVariant": NV(80), "outline": NV(60), "outlineVariant": NV(30),
            "inverseSurface": N(90), "inverseOnSurface": N(20), "shadow": "#000000",
        }
    else:
        r = {
            "primary": P(40), "onPrimary": P(100), "primaryContainer": P(90), "onPrimaryContainer": P(10),
            "secondary": S(40), "onSecondary": S(100), "secondaryContainer": S(90), "onSecondaryContainer": S(10),
            "tertiary": T(40), "onTertiary": T(100), "tertiaryContainer": T(90), "onTertiaryContainer": T(10),
            "error": E(40), "onError": E(100), "success": G(40),
            "background": N(98), "surface": N(98), "surfaceDim": N(87), "surfaceBright": N(98),
            "surfaceContainerLowest": N(100), "surfaceContainerLow": N(96), "surfaceContainer": N(94),
            "surfaceContainerHigh": N(92), "surfaceContainerHighest": N(90),
            "onSurface": N(10), "onSurfaceVariant": NV(30), "outline": NV(50), "outlineVariant": NV(80),
            "inverseSurface": N(20), "inverseOnSurface": N(95), "shadow": "#000000",
        }

    # text drawn straight onto the wallpaper (desktop clocks): pale unless the top of the picture,
    # where clocks usually sit, is really bright (a white sky)
    light_wall = (luma_top if luma_top is not None else luma) > 0.65
    r["wallText"] = P(35) if light_wall else P(88)
    r["wallTextDim"] = P(50) if light_wall else P(70)
    r["wallShadow"] = "#ffffff" if light_wall else "#000000"

    # the names the older parts of the shell use
    r.update({
        "ink": r["surface"], "raised": r["surfaceContainerHigh"], "line": r["outlineVariant"],
        "paper": r["onSurface"], "muted": r["onSurfaceVariant"], "faint": r["outline"],
        "danger": r["error"], "ok": r["success"], "accent": r["primary"],
        "accentDim": r["primaryContainer"], "accentFaint": mix(r["primary"], r["surface"], 0.85),
    })
    # keep "surface" meaning a raised card for the old panels: they draw ink → surface → raised
    r["card"] = r["surfaceContainerLow"]
    r["dark"] = dark
    r["luma"] = luma
    r["scheme"] = flavour
    r["seed"] = seed or DEFAULT_SEED
    r["inkColor"] = "#0c0c0c" if luma > 0.5 else "#ece8e0"

    # 16 terminal colours, nudged toward the seed so they sit in the same room
    ansi_hues = {"red": 25, "green": 145, "yellow": 90, "blue": 255, "magenta": 330, "cyan": 200}
    term = {}
    for name, h in ansi_hues.items():
        h2 = hue_toward(h, sH, 0.12)
        if dark:
            term[name] = oklch_hex(0.72, 0.12, h2)
            term["bright_" + name] = oklch_hex(0.82, 0.10, h2)
        else:
            term[name] = oklch_hex(0.50, 0.13, h2)
            term["bright_" + name] = oklch_hex(0.42, 0.13, h2)
    r["term"] = term
    return r


# ------------------------------------------------------------------ writing files

def write_owned(path: Path, text: str, comment: str = "#") -> bool:
    """write only if the file is ours (has the marker) or doesn't exist."""
    if path.exists() or path.is_symlink():
        try:
            head = path.read_text(encoding="utf-8", errors="replace")[:400]
        except OSError:
            return False
        if MARK not in head:
            print(f"kk-theme: leaving {path} alone (not generated by us)", file=sys.stderr)
            return False
        if path.is_symlink():
            path.unlink()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".kk-tmp")
    tmp.write_text(f"{comment} {MARK} — edits here are overwritten\n{text}", encoding="utf-8")
    tmp.replace(path)
    return True


def quiet(cmd: list[str]) -> None:
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def shell_json(r: dict) -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    out = {k: v for k, v in r.items() if k != "term"}
    # qml can't have a property "onX" next to a property "x" (it reads as a signal handler),
    # so the shell gets these under other names
    for old, new in (("onPrimaryContainer", "primaryContainerText"), ("onSecondaryContainer", "secondaryContainerText"),
                     ("onTertiaryContainer", "tertiaryContainerText"), ("onSurfaceVariant", "surfaceTextDim"),
                     ("onSurface", "surfaceText"), ("onPrimary", "primaryText"), ("onError", "errorText")):
        out[new] = out.pop(old)
    tmp = CACHE / "theme.json.tmp"
    tmp.write_text(json.dumps(out, indent=2), encoding="utf-8")
    tmp.replace(CACHE / "theme.json")  # the shell watches this file


def kitty(r: dict) -> None:
    t = r["term"]
    text = f"""
foreground            {r['onSurface']}
background            {r['surface']}
selection_foreground  {r['onPrimary']}
selection_background  {r['primary']}
cursor                {r['primary']}
cursor_text_color     {r['onPrimary']}
url_color             {r['tertiary']}
active_border_color   {r['primary']}
inactive_border_color {r['outlineVariant']}
active_tab_foreground   {r['onPrimary']}
active_tab_background   {r['primary']}
inactive_tab_foreground {r['onSurfaceVariant']}
inactive_tab_background {r['surfaceContainer']}
tab_bar_background      {r['surface']}
mark1_background {r['primary']}

color0  {r['surfaceContainerHigh']}
color8  {r['outline']}
color1  {t['red']}
color9  {t['bright_red']}
color2  {t['green']}
color10 {t['bright_green']}
color3  {t['yellow']}
color11 {t['bright_yellow']}
color4  {t['blue']}
color12 {t['bright_blue']}
color5  {t['magenta']}
color13 {t['bright_magenta']}
color6  {t['cyan']}
color14 {t['bright_cyan']}
color7  {r['onSurfaceVariant']}
color15 {r['onSurface']}

# extra slots the prompt, fzf and fastfetch use, so they follow the wallpaper too
color16 {r['primary']}
color17 {r['tertiary']}
color18 {r['onSurfaceVariant']}
color19 {r['outline']}
color20 {r['onSurface']}
color21 {r['error']}
color22 {r['secondary']}
"""
    if write_owned(CONFIG / "kitty" / "colors.conf", text):
        quiet(["pkill", "-USR1", "-x", "kitty"])  # kitty reloads its config on SIGUSR1


def hypr(r: dict) -> None:
    a = r["primary"].lstrip("#")
    i = r["outlineVariant"].lstrip("#")
    sh = r["surfaceContainerLowest"].lstrip("#")
    lua = f"""hl.config({{
    decoration = {{
        shadow = {{ color = "rgba({sh}99)" }},
    }},
    general = {{
        col = {{
            active_border   = "rgba({a}ee)",
            inactive_border = "rgba({i}88)",
        }},
    }},
}})
"""
    write_owned(CONFIG / "hypr" / "modules" / "theme.lua", lua, "--")
    quiet(["hyprctl", "eval", f'hl.config({{ general = {{ col = {{ active_border = "rgba({a}ee)", inactive_border = "rgba({i}88)" }} }} }})'])


def hyprlock(r: dict) -> None:
    """colours for the fallback lock screen (hyprlock.conf sources this)."""
    def rgba(h: str) -> str:
        return f"rgba({h.lstrip('#')}ff)"
    text = (f"$kk_bg = {rgba(r['surface'])}\n$kk_fg = {rgba(r['onSurface'])}\n"
            f"$kk_dim = {rgba(r['onSurfaceVariant'])}\n$kk_accent = {rgba(r['primary'])}\n"
            f"$kk_error = {rgba(r['error'])}\n")
    CACHE.mkdir(parents=True, exist_ok=True)
    (CACHE / "hyprlock-colors.conf").write_text(f"# {MARK}\n" + text, encoding="utf-8")


def gtk(r: dict) -> None:
    css = f"""@define-color accent_color {r['primary']};
@define-color accent_bg_color {r['primary']};
@define-color accent_fg_color {r['onPrimary']};
@define-color window_bg_color {r['surface']};
@define-color window_fg_color {r['onSurface']};
@define-color view_bg_color {r['surfaceContainerLow']};
@define-color view_fg_color {r['onSurface']};
@define-color headerbar_bg_color {r['surfaceContainer']};
@define-color headerbar_fg_color {r['onSurface']};
@define-color sidebar_bg_color {r['surfaceContainerLow']};
@define-color sidebar_fg_color {r['onSurface']};
@define-color card_bg_color {r['surfaceContainer']};
@define-color card_fg_color {r['onSurface']};
@define-color popover_bg_color {r['surfaceContainerHigh']};
@define-color popover_fg_color {r['onSurface']};
@define-color dialog_bg_color {r['surfaceContainerLow']};
@define-color dialog_fg_color {r['onSurface']};
@define-color destructive_color {r['error']};
@define-color success_color {r['success']};
@define-color theme_selected_bg_color {r['primary']};
@define-color theme_selected_fg_color {r['onPrimary']};
"""
    # the file manager (thunar, gtk3) in the shell's shape: a tinted sidebar with rounded rows,
    # a pill path bar, soft selections in the wallpaper's colour instead of solid blocks
    files = f"""
/* thunar */
.thunar .sidebar, .thunar .shortcuts-pane, .thunar treeview.sidebar {{ background: {r['surfaceContainer']}; }}
.thunar .sidebar row, .thunar .shortcuts-pane treeview {{ border-radius: 12px; }}
.thunar .sidebar row:selected, .thunar .shortcuts-pane treeview:selected {{ background: alpha({r['primary']}, 0.24); color: {r['onSurface']}; }}
.thunar .path-bar button, .thunar .location-button {{ border-radius: 999px; }}
.thunar .standard-view, .thunar iconview, .thunar treeview.view {{ background: {r['surfaceContainerLow']}; }}
.thunar iconview:selected, .thunar .standard-view iconview:selected {{ background: alpha({r['primary']}, 0.26); color: {r['onSurface']}; border-radius: 14px; }}
.thunar treeview.view:selected {{ background: alpha({r['primary']}, 0.22); color: {r['onSurface']}; }}
.thunar headerbar, .thunar toolbar, .thunar .toolbar {{ background: {r['surfaceContainerLow']}; border: none; box-shadow: none; }}
.thunar statusbar {{ background: {r['surfaceContainerLow']}; color: {r['onSurfaceVariant']}; }}
.thunar entry {{ border-radius: 999px; }}
menu, .menu, .context-menu {{ border-radius: 14px; padding: 6px; background: {r['surfaceContainerHigh']}; }}
menu menuitem {{ border-radius: 8px; padding: 6px 10px; }}
menu menuitem:hover {{ background: alpha({r['primary']}, 0.22); }}
"""
    write_owned(CONFIG / "gtk-3.0" / "gtk.css", css + files, "/*")
    write_owned(CONFIG / "gtk-4.0" / "gtk.css", css, "/*")
    scheme = "prefer-dark" if r["dark"] else "prefer-light"
    quiet(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme])
    quiet(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "adw-gtk3-dark" if r["dark"] else "adw-gtk3"])


def qt(r: dict) -> None:
    """qt6ct palette + kdeglobals colours for KDE apps."""
    a = r["primary"]

    # qt6ct order: WindowText, Button, Light, Midlight, Dark, Mid, Text, BrightText, ButtonText,
    # Base, Window, Shadow, Highlight, HighlightedText, Link, LinkVisited, AlternateBase,
    # NoRole, ToolTipBase, ToolTipText, PlaceholderText, Accent
    def row(fg: str, ph: str) -> str:
        return ", ".join([
            fg, r["surfaceContainerHigh"], r["surfaceContainerHighest"], r["surfaceContainerHigh"],
            r["surfaceContainerLowest"], r["surfaceContainer"], fg, "#ffffff", fg,
            r["surfaceContainerLow"], r["surface"], "#000000", a, r["onPrimary"], a,
            r["tertiary"], r["surfaceContainer"], "#000000", r["surfaceContainerHigh"], fg, ph, a,
        ])
    conf = f"""[ColorScheme]
active_colors={row(r['onSurface'], r['outline'])}
disabled_colors={row(r['outline'], r['outline'])}
inactive_colors={row(r['onSurface'], r['outline'])}
"""
    write_owned(CONFIG / "qt6ct" / "colors" / "kajukatli.conf", conf)

    def rgb(h: str) -> str:
        return ",".join(str(round(v * 255)) for v in hex_rgb(h))
    sections = []
    for sec in ("View", "Window", "Button", "Selection", "Tooltip", "Complementary", "Header"):
        bg = {"View": r["surfaceContainerLow"], "Selection": a, "Button": r["surfaceContainerHigh"],
              "Tooltip": r["surfaceContainerHigh"]}.get(sec, r["surface"])
        fg = r["onPrimary"] if sec == "Selection" else r["onSurface"]
        sections.append(f"""[Colors:{sec}]
BackgroundNormal={rgb(bg)}
BackgroundAlternate={rgb(mix(bg, r['onSurface'], 0.03))}
ForegroundNormal={rgb(fg)}
ForegroundInactive={rgb(r['onSurfaceVariant'])}
ForegroundActive={rgb(a)}
ForegroundLink={rgb(a)}
ForegroundVisited={rgb(r['tertiary'])}
ForegroundNegative={rgb(r['error'])}
ForegroundNeutral={rgb(r['term']['yellow'])}
ForegroundPositive={rgb(r['success'])}
DecorationFocus={rgb(a)}
DecorationHover={rgb(mix(a, r['onSurface'], 0.3))}
""")
    kde = "\n".join(sections) + f"""
[General]
ColorScheme=Kajukatli
AccentColor={rgb(a)}

[KDE]
contrast=4

[Icons]
Theme={'Papirus-Dark' if r['dark'] else 'Papirus'}
"""
    write_owned(CONFIG / "kdeglobals", kde)


def current_link(meta: dict) -> None:
    d = meta.get("dir")
    if not d:
        return
    link = CACHE / "current"
    tmp = CACHE / ".current.tmp"
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    tmp.symlink_to(d)
    tmp.replace(link)


# ------------------------------------------------------------------ main

def load(arg: str) -> tuple[dict, dict]:
    if re.fullmatch(r"#?[0-9a-fA-F]{6}", arg):
        h = arg if arg.startswith("#") else "#" + arg
        return {"seed": h, "accent": h, "luma": 0.3, "luma_top": None}, {}
    p = Path(arg).expanduser()
    if p.is_dir():
        p = p / "meta.json"
    meta = json.loads(p.read_text())
    return {
        "seed": meta.get("seed") or "",
        "accent": meta.get("accent", DEFAULT_SEED),
        "luma": meta.get("luma", 0.3),
        "luma_top": meta.get("luma_top"),
    }, meta


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    arg = sys.argv[1]
    if arg == "--reapply":
        arg = str(CACHE / "current")
        if not Path(arg).exists():
            arg = DEFAULT_SEED
    try:
        src, meta = load(arg)
    except (OSError, ValueError) as e:
        print(f"kk-theme: can't read {arg}: {e}", file=sys.stderr)
        return 1

    st = settings()
    flavour = st.get("themeScheme", "vibrant")
    mode = st.get("themeMode", "dark")
    scheme = build_scheme(src["seed"], src["accent"], float(src["luma"]), flavour, mode, src["luma_top"])

    for step in (shell_json, kitty, hypr, hyprlock, gtk, qt):
        try:
            step(scheme)
        except Exception as e:  # one broken target must never stop the others
            print(f"kk-theme: {step.__name__}: {e}", file=sys.stderr)
    # the terminal greeting's kitty, in the new colours
    quiet([str(Path(__file__).resolve().parent / "kk-hello-art")])
    if meta:
        try:
            current_link(meta)
        except OSError as e:
            print(f"kk-theme: current link: {e}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
