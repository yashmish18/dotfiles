#!/usr/bin/env python3
"""
kk-theme — apply a wallpaper's accent everywhere.

    kk-theme <bundle dir | meta.json | #hex>
    kk-theme --reapply            (uses the current wallpaper)

the base is fixed: ink, paper and five greys. only the accent follows the
wallpaper, and kk-prep has already pulled it toward a muted, printed tone.
files it writes carry a marker line; a file without the marker is yours and
is left alone.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "kajukatli"
MARK = "generated by kk-theme"

BASE = {
    "ink": "#0c0c0c",
    "surface": "#141414",
    "raised": "#1c1c1c",
    "line": "#2a2a2a",
    "paper": "#e8e4dc",
    "muted": "#8f8a80",
    "faint": "#5a5650",
    "danger": "#b5655a",
    "ok": "#8a9a7b",
}


def hex_rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def rgb_hex(r: float, g: float, b: float) -> str:
    c = lambda v: max(0, min(255, round(v)))
    return f"#{c(r):02x}{c(g):02x}{c(b):02x}"


def mix(a: str, b: str, t: float) -> str:
    ra, ga, ba = hex_rgb(a)
    rb, gb, bb = hex_rgb(b)
    return rgb_hex(ra + (rb - ra) * t, ga + (gb - ga) * t, ba + (bb - ba) * t)


def write_owned(path: Path, text: str, comment: str = "#") -> bool:
    """write only if the file is ours (has the marker) or doesn't exist."""
    if path.exists() or path.is_symlink():
        try:
            head = path.read_text(encoding="utf-8", errors="replace")[:400]
        except OSError:
            return False
        if MARK not in head:
            print(f"kk-theme: leaving {path} alone (not generated by us)", file=sys.stderr)
            return False
        if path.is_symlink():
            path.unlink()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".kk-tmp")
    tmp.write_text(f"{comment} {MARK} — edits here are overwritten\n{text}", encoding="utf-8")
    tmp.replace(path)
    return True


def quiet(cmd: list[str]) -> None:
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


# ------------------------------------------------------------------ targets

def shell_json(p: dict) -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = CACHE / "theme.json.tmp"
    tmp.write_text(json.dumps(p, indent=2), encoding="utf-8")
    tmp.replace(CACHE / "theme.json")  # the shell watches this file


def kitty(p: dict) -> None:
    a = p["accent"]
    text = f"""
foreground            {BASE['paper']}
background            {BASE['ink']}
selection_foreground  {BASE['ink']}
selection_background  {a}
cursor                {a}
cursor_text_color     {BASE['ink']}
url_color             {a}
active_border_color   {a}
inactive_border_color {BASE['line']}
active_tab_foreground   {BASE['ink']}
active_tab_background   {a}
inactive_tab_foreground {BASE['muted']}
inactive_tab_background {BASE['surface']}
tab_bar_background      {BASE['ink']}
mark1_background {a}

color0  #1a1a1a
color8  #4a4741
color1  #b5655a
color9  #c47a6f
color2  #8a9a7b
color10 #9fae90
color3  #c2a878
color11 #d3bb8e
color4  #7d8ea3
color12 #93a3b6
color5  #a3879a
color13 #b69bad
color6  #7f9c99
color14 #94b0ad
color7  #c9c4ba
color15 #ece8e0
"""
    if write_owned(CONFIG / "kitty" / "colors.conf", text):
        quiet(["pkill", "-USR1", "-x", "kitty"])  # kitty reloads its config on SIGUSR1


def hypr(p: dict) -> None:
    a = p["accent"].lstrip("#")
    lua = f"""hl.config({{
    general = {{
        col = {{
            active_border   = "rgba({a}ff)",
            inactive_border = "rgba(262626ff)",
        }},
    }},
}})
"""
    write_owned(CONFIG / "hypr" / "modules" / "theme.lua", lua, "--")
    # apply live without a full reload
    quiet(["hyprctl", "eval", f'hl.config({{ general = {{ col = {{ active_border = "rgba({a}ff)" }} }} }})'])


def gtk(p: dict) -> None:
    a = p["accent"]
    css = f"""@define-color accent_color {a};
@define-color accent_bg_color {a};
@define-color accent_fg_color {BASE['ink']};
@define-color window_bg_color {BASE['ink']};
@define-color window_fg_color {BASE['paper']};
@define-color view_bg_color {BASE['surface']};
@define-color view_fg_color {BASE['paper']};
@define-color headerbar_bg_color {BASE['ink']};
@define-color headerbar_fg_color {BASE['paper']};
@define-color sidebar_bg_color {BASE['ink']};
@define-color card_bg_color {BASE['raised']};
@define-color popover_bg_color {BASE['raised']};
@define-color dialog_bg_color {BASE['surface']};
@define-color theme_selected_bg_color {a};
@define-color theme_selected_fg_color {BASE['ink']};
"""
    write_owned(CONFIG / "gtk-3.0" / "gtk.css", css, "/*")
    write_owned(CONFIG / "gtk-4.0" / "gtk.css", css, "/*")


def qt(p: dict) -> None:
    """qt6ct palette (GTK/Qt apps) + kdeglobals colours for KDE apps."""
    a = p["accent"]
    b = BASE
    # qt6ct order: WindowText, Button, Light, Midlight, Dark, Mid, Text, BrightText, ButtonText,
    # Base, Window, Shadow, Highlight, HighlightedText, Link, LinkVisited, AlternateBase,
    # NoRole, ToolTipBase, ToolTipText, PlaceholderText, Accent
    def row(fg, muted):
        return ", ".join([
            fg, b["raised"], "#2e2e2e", "#242424", "#0a0a0a", "#1a1a1a", fg, "#ffffff", fg,
            b["surface"], b["ink"], "#000000", a, b["ink"], a, mix(a, b["muted"], 0.4), "#181818",
            "#000000", b["raised"], fg, muted, a,
        ])
    conf = f"""[ColorScheme]
active_colors={row(b['paper'], b['faint'])}
disabled_colors={row(b['faint'], b['faint'])}
inactive_colors={row(b['paper'], b['faint'])}
"""
    write_owned(CONFIG / "qt6ct" / "colors" / "kajukatli.conf", conf)

    def rgb(h):
        return ",".join(str(v) for v in hex_rgb(h))
    sections = []
    for sec in ("View", "Window", "Button", "Selection", "Tooltip", "Complementary", "Header"):
        bg = {"View": b["surface"], "Selection": a, "Button": b["raised"]}.get(sec, b["ink"])
        fg = b["ink"] if sec == "Selection" else b["paper"]
        sections.append(f"""[Colors:{sec}]
BackgroundNormal={rgb(bg)}
BackgroundAlternate={rgb(mix(bg, '#ffffff', 0.03))}
ForegroundNormal={rgb(fg)}
ForegroundInactive={rgb(b['muted'])}
ForegroundActive={rgb(a)}
ForegroundLink={rgb(a)}
ForegroundVisited={rgb(mix(a, b['muted'], 0.4))}
ForegroundNegative={rgb(b['danger'])}
ForegroundNeutral={rgb('#c2a878')}
ForegroundPositive={rgb(b['ok'])}
DecorationFocus={rgb(a)}
DecorationHover={rgb(mix(a, b['paper'], 0.3))}
""")
    kde = "\n".join(sections) + f"""
[General]
ColorScheme=Kajukatli
AccentColor={rgb(a)}

[KDE]
contrast=4

[Icons]
Theme=Papirus-Dark
"""
    write_owned(CONFIG / "kdeglobals", kde)


def current_link(meta: dict) -> None:
    d = meta.get("dir")
    if not d:
        return
    link = CACHE / "current"
    tmp = CACHE / ".current.tmp"
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    tmp.symlink_to(d)
    tmp.replace(link)


# ------------------------------------------------------------------ main

def load(arg: str) -> tuple[dict, dict]:
    if re.fullmatch(r"#?[0-9a-fA-F]{6}", arg):
        acc = arg if arg.startswith("#") else "#" + arg
        return {"accent": acc, "ink": "#ece8e0", "luma": 0.3}, {}
    p = Path(arg).expanduser()
    if p.is_dir():
        p = p / "meta.json"
    meta = json.loads(p.read_text())
    return {"accent": meta.get("accent", "#c9b79c"), "ink": meta.get("ink_color", "#ece8e0"), "luma": meta.get("luma", 0.3)}, meta


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    arg = sys.argv[1]
    if arg == "--reapply":
        arg = str(CACHE / "current")
        if not Path(arg).exists():
            arg = "#c9b79c"
    try:
        pal, meta = load(arg)
    except (OSError, ValueError) as e:
        print(f"kk-theme: can't read {arg}: {e}", file=sys.stderr)
        return 1

    a = pal["accent"]
    theme = {
        **BASE,
        "accent": a,
        "accentDim": mix(a, BASE["ink"], 0.55),
        "accentFaint": mix(a, BASE["ink"], 0.85),
        "inkColor": pal["ink"],
        "luma": pal["luma"],
    }
    for step in (shell_json, kitty, hypr, gtk, qt):
        try:
            step(theme)
        except Exception as e:  # one broken target must never stop the others
            print(f"kk-theme: {step.__name__}: {e}", file=sys.stderr)
    if meta:
        try:
            current_link(meta)
        except OSError as e:
            print(f"kk-theme: current link: {e}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
