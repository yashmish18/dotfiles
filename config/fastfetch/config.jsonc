// kajukatli · fastfetch. a sleepy cat, a cigarette, the facts.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "38;2;232;228;220", "2": "38;2;90;86;80", "3": "38;2;201;183;156" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;143;138;128", "title": "38;2;201;183;156" },
        "key": { "width": 9 }
    },
    "modules": [
        { "type": "title", "format": "{user-name}{#38;2;90;86;80} at {#}{host-name}" },
        "break",
        { "type": "os", "key": "os", "format": "{name} {#38;2;90;86;80}{arch}" },
        { "type": "kernel", "key": "kernel", "format": "{release}" },
        { "type": "wm", "key": "wm", "format": "{pretty-name}" },
        { "type": "shell", "key": "shell", "format": "{pretty-name}" },
        { "type": "uptime", "key": "awake" },
        { "type": "memory", "key": "memory", "format": "{used} of {total}" },
        { "type": "battery", "key": "battery", "format": "{capacity} {#38;2;90;86;80}{status}" },
        "break",
        { "type": "custom", "format": "{#38;2;90;86;80}meow. type `please` instead of sudo, i won't judge." }
    ]
}
