// kajukatli · fastfetch: the smoking kitty. (KK_HELLO_FIGURE=1 meow: your wallpaper's figure instead, in kitty)
// colours are the terminal's palette slots 16–22, which kk-theme sets from the wallpaper
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "38;5;20", "2": "38;5;19", "3": "38;5;16", "4": "1;38;5;209", "5": "1;38;5;16" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;5;18", "title": "38;5;16" },
        "key": { "width": 8 },
        "bar": { "char": { "elapsed": "━", "total": "━" }, "width": 12, "border": { "left": "", "right": "" } },
        "percent": { "type": ["bar", "num"] }
    },
    "modules": [
        { "type": "title", "format": "{user-name}{#38;5;19} at {#}{host-name}" },
        { "type": "custom", "format": "{#38;5;19}────────────────────────────" },
        { "type": "os", "key": "os", "format": "{name} {#38;5;19}{arch}" },
        { "type": "kernel", "key": "kernel", "format": "{release}" },
        { "type": "wm", "key": "wm", "format": "{pretty-name}" },
        { "type": "packages", "key": "pkgs", "format": "{all}" },
        { "type": "uptime", "key": "awake" },
        { "type": "memory", "key": "memory" },
        { "type": "disk", "key": "disk", "folders": "/" },
        { "type": "battery", "key": "battery", "format": "{capacity-bar} {capacity} {#38;5;19}{status}" },
        {
            "type": "command", "key": "wall",
            "text": "jq -r '.name // empty' \"${XDG_CACHE_HOME:-$HOME/.cache}/kajukatli/current/meta.json\" 2>/dev/null | tr '_-' '  '"
        },
        { "type": "media", "key": "playing", "format": "{title} {#38;5;19}{artist}" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}
