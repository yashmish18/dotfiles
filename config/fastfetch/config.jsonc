// kajukatli · fastfetch: a traditional neofetch-style layout with a hand-drawn ascii cat.
// colours are the terminal's palette slots 16–22, which kk-theme sets from the wallpaper
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data",
        "source": "$1   /\\_____/\\\n$1  /  $2o$1   $2o$1  \\\n$1 ( ==  $3^$1  == )\n$1  )         (\n$1 (           )\n$1( (  )   (  ) )\n$1(__(__)___(__)__)",
        "color": { "1": "38;5;16", "2": "38;5;17", "3": "38;5;21" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;5;16", "title": "38;5;17" },
        "bar": { "char": { "elapsed": "━", "total": "━" }, "width": 10, "border": { "left": "", "right": "" } },
        "percent": { "type": ["bar", "num"] }
    },
    "modules": [
        { "type": "title", "format": "{user-name}{#38;5;19} @ {#}{host-name}" },
        { "type": "custom", "format": "{#38;5;19}──────────────────────────" },
        { "type": "os", "key": "OS      " },
        { "type": "host", "key": "Host    " },
        { "type": "kernel", "key": "Kernel  " },
        { "type": "uptime", "key": "Uptime  " },
        { "type": "packages", "key": "Packages" },
        { "type": "shell", "key": "Shell   " },
        { "type": "wm", "key": "WM      " },
        { "type": "terminal", "key": "Terminal" },
        { "type": "cpu", "key": "CPU     " },
        { "type": "gpu", "key": "GPU     " },
        { "type": "memory", "key": "Memory  " },
        { "type": "disk", "key": "Disk    ", "folders": "/" },
        { "type": "battery", "key": "Battery ", "format": "{capacity-bar} {capacity} {#38;5;19}{status}" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}
