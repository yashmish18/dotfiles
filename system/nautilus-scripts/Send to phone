#!/bin/sh
# nautilus → scripts: the selected files to your phone (kde connect)
id="$(kdeconnect-cli -a --id-only 2>/dev/null | head -n1)"
[ -n "$id" ] || { notify-send -a Files "No phone nearby" "Open KDE Connect on your phone, on the same Wi-Fi."; exit 0; }
printf '%s\n' "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS" | while IFS= read -r f; do
    [ -f "$f" ] && kdeconnect-cli -d "$id" --share "$f"
done
