#!/bin/sh
# started by greetd. newer hyprland ships a start-hyprland watchdog; prefer it when present.
# ~/.local/bin first, so hyprland and everything it starts can find the kk-* scripts.
export PATH="$HOME/.local/bin:$PATH"
if command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland
fi
exec Hyprland
