# kajukatli: let the people in "wheel" set the battery's charge limit without a password
# (settings → power → charge limit). only these two files; nothing else about the battery.
SUBSYSTEM=="power_supply", KERNEL=="BAT*", RUN+="/bin/sh -c 'for f in /sys%p/charge_control_end_threshold /sys%p/charge_control_start_threshold; do [ -e $$f ] && chgrp wheel $$f && chmod 664 $$f; done; true'"
